// app/api/generate-ad/route.ts
import { NextRequest, NextResponse } from "next/server";

const GEMINI_API_KEY = process.env.GEMINI_API_KEY;
const MODEL = "gemini-flash-latest";
const BRAND = "Tegegne";

const PLATFORMS = ["Instagram", "Facebook", "TikTok", "YouTube", "LinkedIn", "X", "Telegram"];
const TONES = ["Inspiring", "Friendly", "Professional", "Bold", "Playful"];

async function callGemini(prompt: string, attempt = 1): Promise<Response> {
  const response = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "x-goog-api-key": GEMINI_API_KEY as string, // key in header, not in the URL
      },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: {
          maxOutputTokens: 3000,
          responseMimeType: "application/json", // model returns pure JSON
        },
      }),
    }
  );

  // retry when the free tier is busy or rate-limited
  if ((response.status === 503 || response.status === 429) && attempt < 3) {
    await new Promise((r) => setTimeout(r, attempt * 1500));
    return callGemini(prompt, attempt + 1);
  }

  return response;
}

export async function POST(req: NextRequest) {
  if (!GEMINI_API_KEY) {
    return NextResponse.json({ error: "Server is missing GEMINI_API_KEY." }, { status: 500 });
  }

  let body: Record<string, unknown>;
  try {
    body = await req.json();
  } catch {
    return NextResponse.json({ error: "Invalid JSON body." }, { status: 400 });
  }

  const offer = String(body.offer ?? "").trim(); // what Tegegne sells: courses, bootcamp, web/app services...
  const audience = String(body.audience ?? "").trim();
  const platform = String(body.platform ?? "Instagram");
  const tone = String(body.tone ?? "Inspiring");
  const language = String(body.language ?? "English").slice(0, 30);

  if (!offer || !audience) {
    return NextResponse.json({ error: "Missing required fields: offer, audience." }, { status: 400 });
  }
  if (offer.length > 1000 || audience.length > 300) {
    return NextResponse.json({ error: "Input is too long." }, { status: 400 });
  }
  if (!PLATFORMS.includes(platform) || !TONES.includes(tone)) {
    return NextResponse.json({ error: "Invalid platform or tone." }, { status: 400 });
  }

  const prompt = `You are an experienced brand copywriter for a coding brand called "${BRAND}".
Write natural, human copy. No corporate jargon, no cliches like "Are you tired of...?", no emoji spam.
Do not invent prices, statistics, awards or guarantees. Only use facts given below.

BRAND: ${BRAND}
WHAT THE BRAND OFFERS: ${offer}
TARGET AUDIENCE: ${audience}
PLATFORM: ${platform}
TONE: ${tone}
LANGUAGE: ${language}

Return ONLY valid JSON in exactly this shape:
{
  "taglines": ["...", "...", "..."],
  "short_ad": "...",
  "video_script": "...",
  "headlines": ["...", "...", "...", "...", "..."],
  "cta_lines": ["...", "...", "..."]
}

- taglines: 3 short brand taglines
- short_ad: 1 ready-to-post ad that fits ${platform}
- video_script: a 30-second script with scene directions and voiceover
- headlines: 5 different ad headlines
- cta_lines: 3 call-to-action lines`;

  try {
    const response = await callGemini(prompt);

    if (!response.ok) {
      const errText = await response.text();
      console.error("Gemini API error:", errText);
      const busy = response.status === 503 || response.status === 429;
      return NextResponse.json(
        { error: busy ? "The AI service is busy. Please try again in a moment." : "AI generation failed. Try again." },
        { status: 502 }
      );
    }

    const data = await response.json();
    const parts: { text?: string }[] = data.candidates?.[0]?.content?.parts ?? [];
    const rawText = parts.map((p) => p.text ?? "").join("");
    const cleaned = rawText.replace(/```json|```/g, "").trim(); // safety net

    let parsed;
    try {
      parsed = JSON.parse(cleaned);
    } catch {
      console.error("Failed to parse model output:", rawText);
      return NextResponse.json({ error: "AI returned an unexpected format. Try again." }, { status: 502 });
    }

    return NextResponse.json(parsed);
  } catch (err) {
    console.error(err);
    return NextResponse.json({ error: "Unexpected server error." }, { status: 500 });
  }
}
